# Kanna production environment (multiuser)
# Copy to /etc/kanna/env or source before starting the server.
#
#   cp deploy/env.example /etc/kanna/env
#   chmod 600 /etc/kanna/env

KANNA_RUNTIME_PROFILE=prod

# Auth & storage
KANNA_AUTH_MODE=multiuser
KANNA_STORAGE=mysql

# MySQL (required for multiuser)
DATABASE_URL=mysql://kanna:CHANGE_ME@127.0.0.1:3306/kanna

# Redis (recommended when running multiple Kanna instances)
REDIS_URL=redis://127.0.0.1:6379

# Object storage for chat attachments (required for multiuser attachments)
# Huawei Cloud OBS — mapped from obs://c-poc-storage/AI-codeflow
#
# obs:// URI breakdown:
#   bucket  = c-poc-storage
#   prefix  = AI-codeflow
# Endpoint (regional, no bucket prefix): obs.cn-north-4.myhuaweicloud.com
# Bucket access domain (virtual-host, do NOT use as KANNA_S3_ENDPOINT):
#   c-poc-storage.obs.cn-north-4.myhuaweicloud.com
KANNA_S3_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
KANNA_S3_REGION=cn-north-4
KANNA_S3_BUCKET=c-poc-storage
KANNA_S3_KEY_PREFIX=AI-codeflow
KANNA_S3_ACCESS_KEY_ID=CHANGE_ME
KANNA_S3_SECRET_ACCESS_KEY=CHANGE_ME
# Optional: override path-style addressing (OBS default is virtual-host / auto-detect)
# KANNA_S3_FORCE_PATH_STYLE=0

# Local dev with MinIO (--profile local-dev):
# KANNA_S3_ENDPOINT=http://127.0.0.1:9000
# KANNA_S3_REGION=us-east-1
# KANNA_S3_BUCKET=kanna
# KANNA_S3_ACCESS_KEY_ID=kanna
# KANNA_S3_SECRET_ACCESS_KEY=kanna_secret

# Encrypts user provider API keys in MySQL (use a random 32+ byte secret)
KANNA_SECRETS_KEY=CHANGE_ME_TO_A_RANDOM_32BYTE_OR_LONGER_SECRET

# Enable when Kanna sits behind HTTPS reverse proxy (Nginx, Cloudflare, etc.)
KANNA_TRUST_PROXY=1

# Disable npm self-update checks (recommended for Docker / pinned deployments)
KANNA_DISABLE_SELF_UPDATE=1
KANNA_DISABLE_UPDATES=1
